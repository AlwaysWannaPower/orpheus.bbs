# =============================================================================
# Dockerfile — ОПИСАНИЕ СБОРКИ ОБРАЗА ПРИЛОЖЕНИЯ.
# -----------------------------------------------------------------------------
# ── ЧТО ТАКОЕ DOCKER В ДВУХ СЛОВАХ ──────────────────────────────────────────
# Docker упаковывает приложение вместе со ВСЕМ его окружением (рантайм,
# библиотеки, настройки) в один переносимый образ. На другом компьютере
# образ запускается точно так же, независимо от того, что там установлено.
#
# Решается главная боль: «у меня работает, а у тебя нет».
#
# ── ЧТО ТАКОЕ МНОГОЭТАПНАЯ СБОРКА (multi-stage build) ──────────────────────
# Каждый блок `FROM ... AS имя` — это ОТДЕЛЬНЫЙ этап со своим набором файлов.
# Финальный образ собирается только из последнего этапа.
#
# Зачем так: для сборки нужны компиляторы, исходники, dev-зависимости
# (сотни мегабайт). Для ЗАПУСКА из этого нужно процентов десять.
# Многоэтапная сборка позволяет «выбросить» лишнее и получить образ
# в разы меньше. Это стандартная практика.
# =============================================================================

# -----------------------------------------------------------------------------
# ЭТАП 1: deps — установка зависимостей.
# -----------------------------------------------------------------------------
# Базовый образ oven/bun — официальный образ с рантаймом Bun.
# Вариант alpine — на базе Alpine Linux, самый компактный.
#
# ── ЗАЧЕМ АРГУМЕНТ BUN_VERSION ──────────────────────────────────────────────
# Он позволяет менять версию Bun при сборке, не правя файл:
#     docker build --build-arg BUN_VERSION=1.4.2 .
# -----------------------------------------------------------------------------
FROM oven/bun:1-alpine AS deps

WORKDIR /app

# Сначала копируем ТОЛЬКО файлы описания зависимостей.
#
# ── ЭТО НЕ МЕЛОЧЬ, А ВАЖНАЯ ОПТИМИЗАЦИЯ ────────────────────────────────────
# Docker кэширует каждый шаг сборки. Если файлы не менялись — шаг берётся
# из кэша и не выполняется заново.
#
# Если скопировать сразу весь проект, то любая правка в коде (даже запятая
# в комментарии) сбросит кэш и заставит переустанавливать все зависимости
# заново — это минуты.
#
# Копируя только package.json и bun.lock, мы говорим: «зависимости
# переустанавливать только если изменился их список».
COPY package.json bun.lock ./

# --frozen-lockfile — установить строго по lock-файлу, без обновлений.
# Это гарантия воспроизводимости: на любой машине встанут ровно те же версии.
RUN bun install --frozen-lockfile

# -----------------------------------------------------------------------------
# ЭТАП 2: builder — сборка приложения.
# -----------------------------------------------------------------------------
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Забираем готовые node_modules из предыдущего этапа.
COPY --from=deps /app/node_modules ./node_modules

# Теперь копируем весь остальной код.
# Файлы, перечисленные в .dockerignore, не попадут в образ
# (например, локальная папка music с гигабайтами mp3).
COPY . .

# ── ВАЖНО: СБОРКА ИДЁТ НА РАНТАЙМЕ BUN ─────────────────────────────────────
# Именно поэтому используется `bun --bun ...`, а не просто `bun run ...`.
# Флаг --bun заставляет выполнять скрипт самим Bun, а не Node.js.
#
# У нас это принципиально: доступ к базе идёт через модуль bun:sqlite,
# которого в Node.js не существует. Если запустить Next на Node, сервер
# стартует, но первое же обращение к базе упадёт.
RUN bun --bun run build

# -----------------------------------------------------------------------------
# ЭТАП 3: runner — то, что реально поедет на сервер.
# -----------------------------------------------------------------------------
FROM oven/bun:1-alpine AS runner

WORKDIR /app

# NODE_ENV=production отключает отладочные механизмы и включает оптимизации.
ENV NODE_ENV=production

# ── ПУТИ К ДАННЫМ ──────────────────────────────────────────────────────────
# Внутри контейнера музыка и база живут по этим адресам. Наружу они
# пробрасываются через volumes в docker-compose.yml.
ENV MUSIC_DIR=/music
ENV DB_PATH=/data/music.db
ENV COVERS_DIR=/data/covers
ENV PORT=3000

# Копируем ТОЛЬКО необходимое для запуска.
# Исходники (src/) в production не нужны: Next.js уже собрал из них
# готовый серверный и клиентский код в папке .next.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.ts ./next.config.ts
COPY --from=builder /app/tsconfig.json ./tsconfig.json

# ── ПАПКА С МИГРАЦИЯМИ ОБЯЗАТЕЛЬНА ─────────────────────────────────────────
# При старте приложение выполняет migrate() и применяет SQL-файлы из ./drizzle.
# Без этой папки база останется без таблиц.
COPY --from=builder /app/drizzle ./drizzle

# Создаём папки для данных. В docker-compose они будут перекрыты volumes,
# но если запустить контейнер без compose — приложение всё равно заработает.
RUN mkdir -p /data/covers /music

# ── ПРО ПОЛЬЗОВАТЕЛЯ ───────────────────────────────────────────────────────
# Хорошая практика — не работать в контейнере от root. Если в приложении
# найдётся уязвимость, злоумышленник получит меньше возможностей.
# В образе oven/bun уже есть пользователь `bun`.
#
# Раскомментируй следующие три строки, если понадобится усилить безопасность
# (нужно будет также выдать права на /data и /music):
#
# RUN chown -R bun:bun /app /data
# USER bun

# Сообщаем, какой порт слушает контейнер.
# Это ДОКУМЕНТАЦИЯ, а не проброс: реальный проброс делается флагом -p
# или через ports в docker-compose.
EXPOSE 3000

# ── HEALTHCHECK ────────────────────────────────────────────────────────────
# Docker периодически проверяет, что приложение живо, обращаясь к API.
# Если проверка падает несколько раз подряд — контейнер помечается
# как нездоровый (unhealthy), и это видно в `docker ps`.
#
# wget входит в Alpine из коробки — отдельно ставить не нужно.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:3000/api/tracks || exit 1

# Команда запуска.
# Обрати внимание: массив JSON, а не строка "bun run start".
# Это форма exec: процесс запускается напрямую, без промежуточного shell.
# Плюс — сигналы (например, SIGTERM при остановке контейнера) доходят
# до приложения, и оно может корректно завершиться.
CMD ["bun", "run", "start"]
