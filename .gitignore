# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# ДОБАВЛЕНО ВРУЧНУЮ ДЛЯ ЭТОГО ПРОЕКТА
# ---------------------------------------------------------------------------

# База данных и обложки: это данные, а не код. Они пересоздаются сканером.
/data/

# Сама музыка. У каждого она своя и весит гигабайты — в git ей не место.
# Папка остаётся в репозитории благодаря файлу music/.gitkeep
/music/*
!/music/.gitkeep

# Локальный кэш пакетов Bun (нужен, если системный ~/.bun недоступен)
/.bun-install/
/.bun-tmp/

# Временные папки инструментов отладки: браузер для тестов
# (bunx playwright install chromium) и конфиг Docker в песочнице.
/.pw-browsers/
/.dc/
/.docker-config/
/.docker-data/

# env-файлы: .env.example коммитим (это шаблон), а .env — нет
!.env.example
