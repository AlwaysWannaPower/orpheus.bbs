# ===========================================================================
# .env.example — ШАБЛОН переменных окружения.
# ---------------------------------------------------------------------------
# Как пользоваться:
#   1. Скопируй файл:  cp .env.example .env
#   2. Поменяй значения под себя.
#   3. Перезапусти dev-сервер (Next.js читает .env только при старте).
#
# Сам файл .env в git не попадает (он в .gitignore), а .env.example — попадает.
# Так принято: в репозитории лежит описание настроек без твоих личных путей.
# ===========================================================================

# Папка с музыкой. Сканер обойдёт её рекурсивно и найдёт все аудиофайлы.
# Путь может быть абсолютным (/home/august/Music) или относительным (./music).
MUSIC_DIR=./music

# Файл базы данных SQLite. Папка создастся автоматически.
DB_PATH=./data/music.db

# Куда сканер складывает вытащенные из тегов обложки альбомов.
COVERS_DIR=./data/covers

# Порт dev-сервера. В Docker этот параметр не нужен (там всегда 3000).
# PORT=3000

# ---------------------------------------------------------------------------
# НЕОБЯЗАТЕЛЬНО: токен доступа к аудио
# ---------------------------------------------------------------------------
# Если задать значение, аудио будет отдаваться только по адресу
#     /api/tracks/1/stream?token=ТВОЙ_ТОКЕН
# Без токена — 401 Unauthorized.
#
# Зачем нужно: запущенный дома плеер виден всем в той же сети (гости,
# соседи по Wi-Fi). Токен закрывает музыку от случайных людей.
#
# ── ВАЖНО ──────────────────────────────────────────────────────────────────
# Переменная называется STREAM_TOKEN, а НЕ NEXT_PUBLIC_STREAM_TOKEN.
# Переменные с префиксом NEXT_PUBLIC_ подставляются в код в момент СБОРКИ,
# поэтому в Docker они не работают: сборка идёт раньше, чем применяются
# переменные окружения контейнера. Сервер читает STREAM_TOKEN во время
# работы и передаёт значение в браузер сам.
#
# Оставь пустым — проверка доступа выключится.
# STREAM_TOKEN=
